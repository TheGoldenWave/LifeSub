{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LifeSub",
  "version": "0.2.1",
  "identifier": "com.goldenwave.lifesub",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LifeSub · 旁白",
        "width": 1180,
        "height": 760,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"],
    "macOS": {
      "signingIdentity": "-",
      "infoPlist": "Info.plist"
    }
  }
}
